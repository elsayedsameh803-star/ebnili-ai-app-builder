# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN / ADMIN_EMAIL / SITE_OWNER_EMAIL: owner-portal credentials.
# Set them as Vercel Environment Variables — never commit a real value here.
# ADMIN_PIN="<set-in-vercel>"
# ADMIN_EMAIL="<set-in-vercel>"
# SITE_OWNER_EMAIL="<set-in-vercel>"

# ── Google OAuth ────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth ────────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: <APP_URL>   ·   Callback URL: <APP_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# AUTH_SESSION_SECRET: Long random string used to sign the session cookie (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty the server falls back to the Google client secret, then to a
# random per-cold-start value (which invalidates sessions on every redeploy).
# AUTH_SESSION_SECRET=""

# ── REQUIRED IN PRODUCTION (security) ─────────────────────────────────────────
# The real admin PIN used to be hard-coded in the source. It has been removed, so
# these variables are now what actually protects the owner dashboard. Generate
# each with the command above and paste into Vercel → Settings → Environment
# Variables. A value shorter than 24 characters is treated as unsafe and ignored.

# Signs the owner session cookie. Without it, no session can be trusted.
# AUTH_SESSION_SECRET="<32+ random hex chars>"

# Signs the Pro/Business plan grant cookie. This is money: with a weak or
# missing value the endpoint refuses to issue a plan rather than handing out a
# forgeable free upgrade. A strong AUTH_SESSION_SECRET is accepted as a fallback.
# PLAN_GRANT_SECRET="<32+ random hex chars>"

# The owner PIN for the admin dashboard. Minimum 8 characters. If it is not set,
# POST /api/admin/auth answers 503 with these instructions instead of "wrong PIN".
# ADMIN_PIN="<8+ chars>"

# Separately signs the admin session cookie. Never falls back to ADMIN_PIN.
# ADMIN_SESSION_SECRET="<32+ random hex chars>"

# The owner account. With this unset, `isOwnerAccount()` is always false, so no
# owner-only surface is exposed at all (the safe default).
# SITE_OWNER_EMAIL="you@example.com"

# ── Supabase (sign-in + the projects database) ────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# Run supabase/projects.sql once in the SQL editor to create the projects table.

# ── Public origin (strongly recommended) ─────────────────────────────────────
# Without APP_URL every OAuth callback host is derived from whichever domain the
# request arrived on. That works, but it means the GitHub repository-import
# callback URL changes if you ever open the app from a preview deployment, and
# GitHub rejects a redirect_uri that is not registered. Pinning it keeps
# /api/github/callback stable at https://ebnily.vercel.app/api/github/callback
APP_URL="https://ebnily.vercel.app"

# ── GitHub repository import ─────────────────────────────────────────────────
# The import flow talks to GitHub DIRECTLY (sign-in is brokered by Supabase), so
# it needs its own OAuth app. Set both, then register the callback shown by the
# import dialog — or GET /api/github/config — on the app.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
