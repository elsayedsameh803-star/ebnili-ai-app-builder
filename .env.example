# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT — copy to `.env` for local development, and set the SAME keys in
# Vercel → Settings → Environment Variables.
#
# READ THIS FIRST
# --------------
# Every secret below is marked REQUIRED. The server now FAILS CLOSED when a
# required secret is missing or weak: it will not fall back to a built-in value.
# That is deliberate — a fallback is how a session-signing key ended up in a
# public repository — but it means a half-configured deployment shows a broken
# sign-in button rather than an insecure one.
#
# Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Run `npm test` after changing anything here: the suite asserts the exact rules
# the server enforces (length, placeholder rejection, fail-closed behaviour).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ───────────────────────────────────────────────────────────

# HMAC key for the sign-in session cookie.
# REQUIRED. Minimum 24 chars. If missing/weak, nobody can sign in and no session
# can be verified — the app will not fall back to a published default.
AUTH_SESSION_SECRET=

# Absolute origin of the deployment, no trailing slash.
# REQUIRED. Used for OAuth redirect URLs and the canonical link in the SEO pages.
#   Production: https://ebnily.vercel.app
#   Local dev:  http://localhost:3000
APP_URL=

# e-mail address of the site owner. Only this account can reach the admin panel.
# REQUIRED. With it unset, `isOwnerAccount()` is always false and no owner
# surface exists at all — the safest possible state.
SITE_OWNER_EMAIL=

# ── Admin console (REQUIRED to unlock the dashboard) ───────────────────────────

# Second factor for the admin panel. Minimum 8 chars.
# NOTE: a real PIN was once committed to this repository. Rotate it — a value that
# was ever in git history must be considered public.
ADMIN_PIN=

# Signing key for the admin session cookie. Falls back to ADMIN_SESSION_SECRET,
# which is acceptable (both are server-side secrets) but a dedicated value is
# better: one compromised key then cannot mint both cookies.
ADMIN_SESSION_SECRET=

# ── Plans & payments ──────────────────────────────────────────────────────────

# Signing key for paid-tier grants. Falls back to AUTH_SESSION_SECRET when unset.
# With neither configured, Pro/Business cannot be granted at all.
PLAN_GRANT_SECRET=

# Object storage for payment receipts. Optional — receipts are still queued in the
# database when unset.
S3_ENDPOINT=
S3_TOKEN=
PAYMENTS_BUCKET=payments-pending

# ── Sign-in providers (Google / GitHub OAuth) ─────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Database (Supabase / PostgREST) ────────────────────────────────────────────

SUPABASE_URL=
# Service-role key. NEVER expose this to the browser — it bypasses row-level
# security. The anon key is safe and is only ever used for OAuth redirects.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI engine ─────────────────────────────────────────────────────────────────

# Without this the studio loads and everything else works, but generation fails.
GEMINI_API_KEY=

# ── Welcome mail for newly granted admins (OPTIONAL) ───────────────────────────
#
# When the owner adds a delegate, the server mails them that they are now an
# admin. OPTIONAL BY DESIGN: with no key set nothing is sent, the grant still
# succeeds, and the UI says the mail was skipped — a mail provider must never
# be able to block granting access.
#
# Provider: Resend (https://resend.com). Any provider with the same REST shape
# works; this is the only mail the project sends, so it calls the API directly
# rather than adding a mail dependency to the serverless bundle.
RESEND_API_KEY=

# Sender shown on the welcome mail. With Resend you must verify this domain;
# the default `onboarding@resend.dev` only delivers to your own account.
MAIL_FROM=Ebnili <onboarding@resend.dev>

# Absolute origin used for the button inside the mail. Optional — falls back to
# https://ebnily.vercel.app, which is correct for production but wrong on a
# preview deployment.
SITE_URL=https://ebnily.vercel.app

# ── Staff accounts (subscription tier) ───────────────────────────────────────

# Addresses that receive the Business tier automatically on sign-in — no payment,
# no expiry. Overrides the built-in defaults (elsayedsameh803@gmail.com,
# maged6086@gmail.com).
#
# SEMANTICS, deliberately distinct:
#   • UNSET  → the built-in defaults apply.
#   • SET    → exactly this list, comma-separated. Setting it to "" removes
#              everyone, so clearing the variable really does revoke the tier
#              instead of silently restoring the defaults.
#
# SCOPE: this grants the PAID FEATURES only (no export watermark, custom domains,
# the raised generation ceiling). It does NOT grant the admin console — that stays
# `SITE_OWNER_EMAIL` + `ADMIN_PIN`, two independent factors.
STAFF_EMAILS=

# ── CORS (Phase 2 hardening) ──────────────────────────────────────────────────

# Comma-separated list of browser origins allowed to call this API.
# Falls back to APP_URL, then to the request's own host.
#
# SECURITY: this used to be `*`, which let any website read this API's responses
# from a visitor's browser. Set it explicitly in production:
#   https://ebnily.vercel.app
ALLOWED_ORIGINS=

# ── Rate limits (Phase 2 hardening) ───────────────────────────────────────────
# Defaults are safe. Override only if you know why. Set `_MAX` to 0 or a
# non-number to fall back to the default rather than disabling the limiter.

# Whole API, any identity.  Default 300 / minute.
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000

# AI endpoints (they spend the Gemini key). Default 20 / minute.
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=60000

# Project writes and payment receipts. Default 30 / minute.
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=60000

# Admin login attempts. Default 20 / 10 minutes.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=600000
