# Local runtime data — these are mutable state files, not source, and the
# legacy settings file can hold owner credentials. They must never be in git.
admin_settings.json
devices_db.json
subscriptions_db.json

tsc-out.txt
.env

# Scratch files produced while debugging the AI endpoints. `pr.json` is a
# hand-typed request body left over from curl-ing /api/ai/* — not project data.
_*.txt
_*.cmd
_*.ps1
_*.log
pr.json

# Scratch output from the local verification run (build logs, curl response
# files, git probes). These are regenerated on every run and must not ship.
# Generated brand images (scripts/generate-brand-images.mjs). They are rebuilt
# on every `npm run build`, so committing them would only create conflicts the
# next time a pixel changes.
public/og-image.png
public/apple-touch-icon.png
public/favicon.png

checks_out.txt
server_out.txt
tsc_out.txt
